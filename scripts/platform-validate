#!/usr/bin/env bash

set -euo pipefail

cluster_context="kind-otel-demo-local"

if ! kubectl config get-contexts "${cluster_context}" --no-headers >/dev/null 2>&1; then
  echo "Expected context ${cluster_context} does not exist in the standard kubeconfig." >&2
  echo "Run 'make cluster-create' to create or restore it." >&2
  exit 1
fi

kubectl \
  --context "${cluster_context}" \
  wait \
  --namespace nginx-gateway \
  --for=condition=Available \
  deployment \
  --all \
  --timeout=300s

kubectl \
  --context "${cluster_context}" \
  wait \
  --namespace argocd \
  --for=condition=Available \
  deployment \
  --all \
  --timeout=300s

kubectl \
  --context "${cluster_context}" \
  rollout \
  status \
  statefulset \
  --namespace argocd \
  --timeout=300s

for required_crd in \
  gatewayclasses.gateway.networking.k8s.io \
  gateways.gateway.networking.k8s.io \
  httproutes.gateway.networking.k8s.io \
  applications.argoproj.io; do
  if ! kubectl \
    --context "${cluster_context}" \
    get customresourcedefinition "${required_crd}" >/dev/null 2>&1; then
    echo "Missing required CRD: ${required_crd}" >&2
    exit 1
  fi
done

if ! kubectl \
  --context "${cluster_context}" \
  get gatewayclass nginx >/dev/null 2>&1; then
  echo "NGINX GatewayClass is not available." >&2
  exit 1
fi

if kubectl \
  --context "${cluster_context}" \
  get namespace opentelemetry-demo >/dev/null 2>&1; then
  echo "Application namespace exists before the GitOps milestone." >&2
  exit 1
fi

echo "Milestone 3 platform validation passed."
echo
echo "NGINX Gateway Fabric:"
kubectl --context "${cluster_context}" get pods --namespace nginx-gateway
echo
echo "Argo CD:"
kubectl --context "${cluster_context}" get pods --namespace argocd
echo
echo "GatewayClass:"
kubectl --context "${cluster_context}" get gatewayclass nginx
