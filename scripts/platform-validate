#!/usr/bin/env bash

set -euo pipefail

repository_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
kubeconfig_path="${repository_root}/.state/kubeconfig"

if [[ ! -f "${kubeconfig_path}" ]]; then
  echo "Expected kubeconfig does not exist: ${kubeconfig_path}" >&2
  exit 1
fi

kubectl \
  --kubeconfig "${kubeconfig_path}" \
  wait \
  --namespace nginx-gateway \
  --for=condition=Available \
  deployment \
  --all \
  --timeout=300s

kubectl \
  --kubeconfig "${kubeconfig_path}" \
  wait \
  --namespace argocd \
  --for=condition=Available \
  deployment \
  --all \
  --timeout=300s

kubectl \
  --kubeconfig "${kubeconfig_path}" \
  rollout \
  status \
  statefulset \
  --namespace argocd \
  --timeout=300s

for required_crd in \
  gatewayclasses.gateway.networking.k8s.io \
  gateways.gateway.networking.k8s.io \
  httproutes.gateway.networking.k8s.io \
  applications.argoproj.io; do
  if ! kubectl \
    --kubeconfig "${kubeconfig_path}" \
    get customresourcedefinition "${required_crd}" >/dev/null 2>&1; then
    echo "Missing required CRD: ${required_crd}" >&2
    exit 1
  fi
done

if ! kubectl \
  --kubeconfig "${kubeconfig_path}" \
  get gatewayclass nginx >/dev/null 2>&1; then
  echo "NGINX GatewayClass is not available." >&2
  exit 1
fi

if kubectl \
  --kubeconfig "${kubeconfig_path}" \
  get namespace opentelemetry-demo >/dev/null 2>&1; then
  echo "Application namespace exists before the GitOps milestone." >&2
  exit 1
fi

echo "Milestone 3 platform validation passed."
echo
echo "NGINX Gateway Fabric:"
kubectl --kubeconfig "${kubeconfig_path}" get pods --namespace nginx-gateway
echo
echo "Argo CD:"
kubectl --kubeconfig "${kubeconfig_path}" get pods --namespace argocd
echo
echo "GatewayClass:"
kubectl --kubeconfig "${kubeconfig_path}" get gatewayclass nginx

