#!/usr/bin/env bash

set -euo pipefail

repository_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cluster_name="otel-demo-local"
expected_context="kind-otel-demo-local"
kubeconfig_path="${repository_root}/.state/kubeconfig"

cluster_exists="false"

while IFS= read -r existing_cluster; do
  if [[ "${existing_cluster}" == "${cluster_name}" ]]; then
    cluster_exists="true"
    break
  fi
done < <(kind get clusters 2>/dev/null)

if [[ "${cluster_exists}" != "true" ]]; then
  echo "Cluster ${cluster_name} does not exist." >&2
  exit 1
fi

if [[ ! -f "${kubeconfig_path}" ]]; then
  echo "Expected kubeconfig does not exist: ${kubeconfig_path}" >&2
  exit 1
fi

actual_context="$(
  kubectl \
    --kubeconfig "${kubeconfig_path}" \
    config \
    current-context
)"

if [[ "${actual_context}" != "${expected_context}" ]]; then
  echo "Expected context ${expected_context}, found ${actual_context}." >&2
  exit 1
fi

not_ready_nodes="$(
  kubectl \
    --kubeconfig "${kubeconfig_path}" \
    get nodes \
    --no-headers |
    awk '$2 != "Ready" {print $1}'
)"

if [[ -n "${not_ready_nodes}" ]]; then
  echo "Nodes are not Ready: ${not_ready_nodes}" >&2
  exit 1
fi

echo "Cluster validation passed."
echo "Cluster: ${cluster_name}"
echo "Context: ${actual_context}"
kubectl --kubeconfig "${kubeconfig_path}" get nodes
