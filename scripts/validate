#!/usr/bin/env bash

set -euo pipefail

cluster_name="otel-demo-local"
expected_context="kind-otel-demo-local"

cluster_exists="false"

while IFS= read -r existing_cluster; do
  if [[ "${existing_cluster}" == "${cluster_name}" ]]; then
    cluster_exists="true"
    break
  fi
done < <(kind get clusters 2>/dev/null)

if [[ "${cluster_exists}" != "true" ]]; then
  echo "Cluster ${cluster_name} does not exist." >&2
  exit 1
fi

if ! kubectl config get-contexts "${expected_context}" --no-headers >/dev/null 2>&1; then
  echo "Expected context ${expected_context} does not exist in the standard kubeconfig." >&2
  echo "Run 'make cluster-create' to create or restore it." >&2
  exit 1
fi

not_ready_nodes="$(
  kubectl \
    --context "${expected_context}" \
    get nodes \
    --no-headers |
    awk '$2 != "Ready" {print $1}'
)"

if [[ -n "${not_ready_nodes}" ]]; then
  echo "Nodes are not Ready: ${not_ready_nodes}" >&2
  exit 1
fi

echo "Cluster validation passed."
echo "Cluster: ${cluster_name}"
echo "Context: ${expected_context}"
kubectl --context "${expected_context}" get nodes
