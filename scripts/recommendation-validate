#!/usr/bin/env bash

set -euo pipefail

repository_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
apps_repository="${APPS_REPOSITORY:-${repository_root}/../otel-demo-apps}"
kubeconfig_path="${repository_root}/.state/kubeconfig"
cluster_name="otel-demo-local"
workload_namespace="opentelemetry-demo"
direct_image_repository="otel-demo/recommendation"
registry_image_repository="ghcr.io/lackito/otel-demo-local-recommendation"
demo_url="http://otel-demo.localhost"

if [[ ! -f "${kubeconfig_path}" ]]; then
  echo "Expected kubeconfig does not exist: ${kubeconfig_path}" >&2
  exit 1
fi

apps_revision="$(git -C "${apps_repository}" rev-parse HEAD)"
direct_image="${direct_image_repository}:local-${apps_revision:0:12}"

application_state="$(
  kubectl \
    --kubeconfig "${kubeconfig_path}" \
    get application otel-demo-local \
    --namespace argocd \
    --output jsonpath='{.status.sync.status} {.status.health.status}'
)"

if [[ "${application_state}" != "Synced Healthy" ]]; then
  echo "Argo CD application state is ${application_state}; expected Synced Healthy." >&2
  exit 1
fi

deployed_image="$(
  kubectl \
    --kubeconfig "${kubeconfig_path}" \
    get deployment recommendation \
    --namespace "${workload_namespace}" \
    --output jsonpath='{.spec.template.spec.containers[0].image}'
)"

if [[ "${deployed_image}" == "${direct_image}" ]]; then
  loaded_image="$(
    docker exec \
      "${cluster_name}-control-plane" \
      crictl images \
      --output json |
      grep -F "${direct_image}" || true
  )"

  if [[ -z "${loaded_image}" ]]; then
    echo "${direct_image} is not loaded in the kind node." >&2
    exit 1
  fi
  delivery_mode="direct kind load"
elif [[ "${deployed_image}" == "${registry_image_repository}:"* ]]; then
  registry_tag="${deployed_image#"${registry_image_repository}:"}"
  if [[ ! "${registry_tag}" =~ ^[0-9a-f]{40}$ ]]; then
    echo "Registry image tag is not a full Git commit SHA: ${registry_tag}" >&2
    exit 1
  fi
  delivery_mode="local CI and GHCR"
else
  echo "Recommendation uses ${deployed_image}." >&2
  echo "Expected ${direct_image} or ${registry_image_repository}:<full-git-sha>." >&2
  exit 1
fi

kubectl \
  --kubeconfig "${kubeconfig_path}" \
  rollout status deployment/recommendation \
  --namespace "${workload_namespace}" \
  --timeout=180s

api_response="$(
  curl \
    --fail \
    --silent \
    --show-error \
    "${demo_url}/api/recommendations?productIds=OLJCESPC7Z"
)"

if [[ -z "${api_response}" || "${api_response}" != *'"id"'* ]]; then
  echo "Recommendation API did not return a product list." >&2
  exit 1
fi

echo "Recommendation validation passed."
echo "Application: ${application_state}"
echo "Image: ${deployed_image}"
echo "Delivery: ${delivery_mode}"
echo "Recommendation API: HTTP 200 with product data"
