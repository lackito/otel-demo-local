#!/usr/bin/env bash

set -euo pipefail

repository_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cluster_name="otel-demo-local"
cluster_context="kind-${cluster_name}"
cluster_config="${repository_root}/kind/cluster.yaml"
kubeconfig_path="${HOME}/.kube/config"

mkdir -p "$(dirname "${kubeconfig_path}")"

cluster_exists="false"

while IFS= read -r existing_cluster; do
  if [[ "${existing_cluster}" == "${cluster_name}" ]]; then
    cluster_exists="true"
    break
  fi
done < <(kind get clusters 2>/dev/null)

if [[ "${cluster_exists}" == "true" ]]; then
  echo "Cluster ${cluster_name} already exists."

  if ! kubectl config get-contexts "${cluster_context}" --no-headers >/dev/null 2>&1; then
    echo "Restoring context ${cluster_context} in ${kubeconfig_path}."
    kind export kubeconfig \
      --name "${cluster_name}" \
      --kubeconfig "${kubeconfig_path}"
  fi

  echo "Run 'kubectl config use-context ${cluster_context}' for interactive use."
  echo "Run 'make validate' to check the cluster or 'make cluster-destroy' first."
  exit 0
fi

kind create cluster \
  --name "${cluster_name}" \
  --config "${cluster_config}" \
  --kubeconfig "${kubeconfig_path}"

kubectl \
  --context "${cluster_context}" \
  wait \
  --for=condition=Ready \
  node \
  --all \
  --timeout=120s

echo "Cluster ${cluster_name} is ready."
echo "Context: ${cluster_context} in ${kubeconfig_path}"
echo "Run 'kubectl config use-context ${cluster_context}' for interactive use."
